# agent-sandbox base image "ubuntu:26.04" (embedded in the binary; override
# with ~/.config/agent-sandbox/base/ubuntu/Containerfile).

# node and npm come from the official Node.js image (glibc, built on Debian
# 12), so every glibc base runs the same Node.js LTS the agents need.
FROM docker.io/library/node:24-bookworm-slim AS node

FROM docker.io/library/ubuntu:26.04

# The image ships a user "ubuntu" with uid 1000, which would take the place
# of the session user's passwd entry under --userns=keep-id.
RUN userdel --remove ubuntu

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        gcc \
        gh \
        git \
        jq \
        less \
        libc6-dev \
        make \
        procps \
        python3 \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# The agents need Node.js >= 22.19.
RUN node -e 'const [a, b] = process.versions.node.split(".").map(Number); if (a < 22 || (a === 22 && b < 19)) { console.error("node " + process.version + " is too old, the agents need >= 22.19"); process.exit(1) }'

# The agents are baked into the image, installed globally and owned by root:
# sessions run as an unprivileged user and cannot replace them. Self-update is
# disabled as well, so agents do not try and fail on every start.
ENV DISABLE_AUTOUPDATER=1 \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN npm install -g --no-fund --no-audit \
        @anthropic-ai/claude-code \
        @opencode/cli \
        @earendil-works/pi-coding-agent && \
    npm cache clean --force

# agent-sandbox base image "fedora:45" (embedded in the binary; override with
# ~/.config/agent-sandbox/base/fedora/Containerfile).
FROM registry.fedoraproject.org/fedora:45

RUN dnf -y install --setopt=install_weak_deps=False \
        ca-certificates \
        curl \
        fd-find \
        gcc \
        gh \
        git \
        jq \
        less \
        make \
        nodejs \
        npm \
        procps-ng \
        python3 \
        ripgrep \
        which \
    && dnf clean all

# The agents need Node.js >= 22.19.
RUN node -e 'const [a, b] = process.versions.node.split(".").map(Number); if (a < 22 || (a === 22 && b < 19)) { console.error("node " + process.version + " is too old, the agents need >= 22.19"); process.exit(1) }'

# The agents are baked into the image, installed globally and owned by root:
# sessions run as an unprivileged user and cannot replace them. Self-update is
# disabled as well, so agents do not try and fail on every start.
ENV DISABLE_AUTOUPDATER=1 \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN npm install -g --no-fund --no-audit \
        @anthropic-ai/claude-code \
        @opencode/cli \
        @earendil-works/pi-coding-agent && \
    npm cache clean --force
